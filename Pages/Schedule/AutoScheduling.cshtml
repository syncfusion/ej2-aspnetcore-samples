@page
@model EJ2CoreSampleBrowser.Pages.Schedule.AutoScheduling
@using Syncfusion.EJ2
@using Newtonsoft.Json
@using Syncfusion.EJ2.Buttons

@{
    var resourceData = Model.ResourceData;
    var gridData = Model.GridData;
    var eventData = Model.EventData;
    var resources = new string[] { "Staff" };
}

@{
    string autoScheduleTemplate =
        "<button id='autoScheduleBtn'></button>";
}

@section ControlsSection{
<div class="schedule-control-section">
    <div class="col-lg-12 control-section">
        <div class="control-wrapper auto-scheduling">
            <div class="schedule-container">

                <div class="schedule-content">
                    <h5 style="text-align:center; margin:0; position:relative; bottom:10px;">
                        Automated Appointment Assignment
                    </h5>

                    <ejs-schedule id="Schedule"
                                  width="100%"
                                  height="100%"
                                  startHour="08:00"
                                  cssClass="grid-auto-scheduling"
                                  currentView="TimelineDay"
                                  AllowOverlap ="false"
                                  AllowResizing ="false"
                                  selectedDate="DateTime.Today">

                        <e-schedule-group resources="@resources">
                        </e-schedule-group>

                        <e-schedule-views>
                            <e-schedule-view option="TimelineDay"></e-schedule-view>
                        </e-schedule-views>

                        <e-schedule-resources>
                            <e-schedule-resource dataSource="@resourceData"
                                                 field="StaffId"
                                                 title="Staff"
                                                 name="Staff"
                                                 textField="text"
                                                 idField="id"
                                                 colorField="color"
                                                 groupIDField="group">
                            </e-schedule-resource>
                        </e-schedule-resources>

                        <e-schedule-eventsettings dataSource="@eventData">
                        </e-schedule-eventsettings>

                        <e-schedule-toolbaritems>
                            <e-schedule-toolbaritem name="Previous" align="Left"></e-schedule-toolbaritem>
                            <e-schedule-toolbaritem name="Next" align="Left"></e-schedule-toolbaritem>
                            <e-schedule-toolbaritem name="DateRangeText" align="Left"></e-schedule-toolbaritem>
                            <e-schedule-toolbaritem name="Today" align="Right"></e-schedule-toolbaritem>

                           <e-schedule-toolbaritem name="Custom"
                                                    type="Input"
                                                    align="Right"
                                                    template="@autoScheduleTemplate">
                            </e-schedule-toolbaritem>
                        </e-schedule-toolbaritems>
                    </ejs-schedule>
                    
                </div>

                <div class="grid-content">
                    <h5 style="text-align:center; margin:0; position:relative; bottom:10px;">
                        Unplanned Appointments
                    </h5>

                    <ejs-grid id="Grid"
                              cssClass="drag-grid-data"
                              dataSource="@gridData"
                              width="300"
                              rowDrag="onRowDrag"
                              height="100%"
                              allowRowDragAndDrop="true">

                        <e-grid-rowdropsettings targetID="Schedule"></e-grid-rowdropsettings>

                        <e-grid-editsettings allowAdding="true"
                                             allowEditing="true"
                                             allowDeleting="true">
                        </e-grid-editsettings>


                        <e-grid-columns>

                            <e-grid-column field="Id"
                                           isPrimaryKey="true"
                                           visible="false">
                            </e-grid-column>

                            <e-grid-column field="Task"
                                           headerText="Task"
                                           width="200"
                                           template="#taskTemplate">
                            </e-grid-column>

                            <e-grid-column field="Duration"
                                           headerText="Duration"
                                           width="110">
                            </e-grid-column>

                        </e-grid-columns>

                    </ejs-grid>
                </div>

            </div>
        </div>
    </div>
</div>

<script id="taskTemplate" type="text/x-template">
    <div class="task-template">
        <div class="task-name">${Task}</div>
        <div class="task-skill">${RequiredSkill}</div>
    </div>
</script>

<script>
    var resourceData = @Html.Raw(JsonConvert.SerializeObject(Model.ResourceData));
    var gridData = @Html.Raw(JsonConvert.SerializeObject(Model.GridData));
    var scheduleData = @Html.Raw(JsonConvert.SerializeObject(Model.EventData));
</script>
}



<script>

var MAX_DAILY_WORKLOAD = 8;
var draggedEventData = null;
var scheduledAppointments = new Set();

var scheduleObj;
var gridObj;

document.addEventListener('DOMContentLoaded', function () {

    scheduleObj = document.getElementById('Schedule').ej2_instances[0];
    gridObj = document.getElementById('Grid').ej2_instances[0];

    initializeSchedulerEvents();
    initializeGridEvents();

    scheduleObj.resourceHeaderTemplate = function (props) {
        return getResourceHeader(props);
    };

    scheduleObj.refreshTemplates("resourceHeaderTemplate");
});

function parseDuration(duration) {
    return parseInt(duration.split(' ')[0], 10);
}

function safeDeleteGridRecord(record) {

    if (!record) {
        return;
    }

    gridData = gridData.filter(function (item) {
        return item.Id !== record.Id;
    });

    gridObj.dataSource = gridData;
    gridObj.refresh();
}

function createAutoScheduleButton() {

    var btn = document.getElementById('autoScheduleBtn');

    if (!btn || btn.classList.contains('e-btn')) {
        return;
    }

    var buttonObj = new ej.buttons.Button({
        content: 'Auto Scheduling',
        cssClass: 'e-primary'
    });

    buttonObj.appendTo(btn);

    buttonObj.element.onclick = handleAutoScheduling;
}

function getResourceWorkloadForDate(resourceId, date, excludeEventId) {

    var events = scheduleObj.getEvents() || [];

    var targetDate = new Date(date);
    targetDate.setHours(0,0,0,0);

    var total = 0;

    events.forEach(function(event){

        var eventDate = new Date(event.StartTime);
        eventDate.setHours(0,0,0,0);

        if (
            event.StaffId === resourceId &&
            eventDate.getTime() === targetDate.getTime() &&
            (!excludeEventId || event.Id !== excludeEventId)
        ) {
            total += (
                new Date(event.EndTime) -
                new Date(event.StartTime)
            ) / 3600000;
        }
    });

    return total;
}

function isTimeSlotAvailableForResource(resourceId,start,end) {

    var events = scheduleObj.getEvents() || [];

    return !events.some(function(event){

        if (event.StaffId !== resourceId) {
            return false;
        }

        return (
            start.getTime() < new Date(event.EndTime).getTime() &&
            end.getTime() > new Date(event.StartTime).getTime()
        );
    });
}

function getEventSkill(eventData) {

    if (eventData.RequiredSkill) {
        return eventData.RequiredSkill;
    }

    var subject = eventData.Subject || '';

    for (var i=0;i<resourceData.length;i++) {

        for (var j=0;j<resourceData[i].skills.length;j++) {

            if (subject.indexOf(resourceData[i].skills[j]) !== -1) {
                return resourceData[i].skills[j];
            }
        }
    }

    return 'General';
}

function findAvailableTimeSlotForResource(
    resourceId,
    durationHours,
    date,
    tempScheduledEvents
) {

    var dayStart = new Date(date);
    dayStart.setHours(0,0,0,0);

    var dayEnd = new Date(date);
    dayEnd.setHours(23,59,59,999);

    var workingStart = new Date(dayStart);
    workingStart.setHours(9,0,0,0);

    var workingEnd = new Date(dayStart);
    workingEnd.setHours(23,0,0,0);

    var resourceEvents =
        scheduleObj.getEvents(dayStart, dayEnd)
        .filter(function(e){
            return e.StaffId === resourceId;
        });

    if (tempScheduledEvents) {

        tempScheduledEvents.forEach(function(e){

            if (e.StaffId === resourceId) {
                resourceEvents.push(e);
            }
        });
    }

    resourceEvents.sort(function(a,b){

        return new Date(a.StartTime) -
               new Date(b.StartTime);
    });

    var durationMs =
        durationHours * 60 * 60 * 1000;

    if (!resourceEvents.length) {

        return {
            startTime: workingStart,
            endTime: new Date(
                workingStart.getTime() + durationMs
            )
        };
    }

    var firstEvent =
        new Date(resourceEvents[0].StartTime);

    if (
        workingStart.getTime() + durationMs <=
        firstEvent.getTime()
    ) {

        return {
            startTime: workingStart,
            endTime: new Date(
                workingStart.getTime() + durationMs
            )
        };
    }

    for (var i=0;i<resourceEvents.length-1;i++) {

        var currentEnd =
            new Date(resourceEvents[i].EndTime);

        var nextStart =
            new Date(resourceEvents[i+1].StartTime);

        if (
            nextStart.getTime() -
            currentEnd.getTime()
            >= durationMs
        ) {

            return {
                startTime: currentEnd,
                endTime: new Date(
                    currentEnd.getTime() + durationMs
                )
            };
        }
    }

    var lastEnd =
        new Date(
            resourceEvents[
                resourceEvents.length - 1
            ].EndTime
        );

    if (
        lastEnd.getTime() + durationMs <=
        workingEnd.getTime()
    ) {

        return {
            startTime: lastEnd,
            endTime: new Date(
                lastEnd.getTime() + durationMs
            )
        };
    }

    return null;
}

function handleAutoScheduling() {

    var tempScheduledEvents = [];
    var workloadMap = {};

    resourceData.forEach(function(resource){

        workloadMap[resource.id] =
            getResourceWorkloadForDate(
                resource.id,
                scheduleObj.selectedDate
            );
    });

    var allEvents = scheduleObj.getEvents();

    var nextId =
        allEvents.length
            ? Math.max.apply(
                null,
                allEvents.map(e => e.Id)
              ) + 1
            : 1;

    gridData.forEach(function(task){

        var durationHours =
            parseDuration(task.Duration);

        var matchingResources =
            resourceData.filter(function(resource){

                return resource.skills.indexOf(
                    task.RequiredSkill
                ) !== -1;
            });

        var bestResource = null;
        var bestSlot = null;
        var bestWorkload = Infinity;

        matchingResources.forEach(function(resource){

            var workload =
                workloadMap[resource.id] || 0;

            if (
                workload + durationHours >
                MAX_DAILY_WORKLOAD
            ) {
                return;
            }

            var slot =
                findAvailableTimeSlotForResource(
                    resource.id,
                    durationHours,
                    scheduleObj.selectedDate,
                    tempScheduledEvents
                );

            if (!slot) {
                return;
            }

            if (workload < bestWorkload) {

                bestResource = resource;
                bestSlot = slot;
                bestWorkload = workload;
            }
        });

        if (!bestResource || !bestSlot) {
            return;
        }

        var newEvent = {

            Id: nextId++,
            Subject: task.Task,
            StartTime: bestSlot.startTime,
            EndTime: bestSlot.endTime,
            StaffId: bestResource.id,
            RequiredSkill: task.RequiredSkill,
            IsAllDay: false
        };

        scheduleObj.addEvent(newEvent);

        tempScheduledEvents.push(newEvent);

        workloadMap[bestResource.id] =
            bestWorkload + durationHours;

        scheduledAppointments.add(task.Id);
    });

    gridData =
        gridData.filter(function(item){
            return !scheduledAppointments.has(item.Id);
        });

    gridObj.dataSource = gridData;
    gridObj.refresh();

    scheduleObj.refreshTemplates(
        "resourceHeaderTemplate"
    );
}

function getResourceHeader(props) {

    var data = props.resourceData || props;

    var workload =
        getResourceWorkloadForDate(
            data.id,
            scheduleObj.selectedDate
        );

    var skills =
        data.skills.map(function(skill){

            return '<span class="skill-badge">' +
                    skill +
                    '</span>';
        }).join('');

    return (
        '<div class="resource-header-container">' +
            '<div class="resource-header-avatar" style="background:' + data.color + '">' +
                data.text.charAt(0) +
            '</div>' +
            '<div class="resource-header-info">' +
                '<div class="resource-header-name">' +
                    data.text +
                '</div>' +
                '<div class="resource-header-skills">' +
                    skills +
                '</div>' +
            '</div>' +
            '<div class="resource-header-workload">' +
                workload +
                '/8h' +
            '</div>' +
        '</div>'
    );
}
function onRowDrag(args) {
    args.cancel = true;
}

function initializeSchedulerEvents() {

    scheduleObj.cellClick = function(args){
        args.cancel = true;
    };

    scheduleObj.dragStart = function (args) {
        draggedEventData = Object.assign({}, args.data);
    };

    scheduleObj.dragStop = function (args) {

        if (!draggedEventData || !args.data) {
            return;
        }

        var duration =
            (new Date(args.data.EndTime) -
                new Date(args.data.StartTime)) / 3600000;

        var workload =
            getResourceWorkloadForDate(
                args.data.StaffId,
                args.data.StartTime,
                args.data.Id
            );

        // Workload validation FIRST
        if (workload + duration > MAX_DAILY_WORKLOAD) {
            args.cancel = true;
            draggedEventData = null;
            return;
        }

        var hasResourceChanged =
            draggedEventData.StaffId !== args.data.StaffId;

        var hasTimeChanged =
            new Date(draggedEventData.StartTime).getTime() !==
            new Date(args.data.StartTime).getTime();

        if (hasResourceChanged || hasTimeChanged) {

            var targetResource = resourceData.find(function (r) {
                return r.id === args.data.StaffId;
            });

            var eventSkill =
                draggedEventData.RequiredSkill ||
                getEventSkill(draggedEventData);

            if (
                targetResource &&
                targetResource.skills.indexOf(eventSkill) === -1
            ) {

                args.data.StaffId = draggedEventData.StaffId;
                args.data.StartTime = new Date(draggedEventData.StartTime);
                args.data.EndTime = new Date(draggedEventData.EndTime);

                scheduleObj.saveEvent(args.data);
            }
        }

        draggedEventData = null;
    };

    scheduleObj.popupOpen = function (args) {
        if (args.type === 'Editor') {
            args.cancel = true;
        }
    };

    scheduleObj.actionBegin = function (args) {

    if (args.requestType !== 'eventChange') {
        return;
    }

    var data = Array.isArray(args.data)
        ? args.data[0]
        : args.data;

    // Workload validation
    var duration =
        (new Date(data.EndTime) -
            new Date(data.StartTime)) / 3600000;

    var workload =
        getResourceWorkloadForDate(
            data.StaffId,
            data.StartTime,
            data.Id
        );

    if (
        workload + duration >
        MAX_DAILY_WORKLOAD
    ) {
        args.cancel = true;
        return;
    }
};

    scheduleObj.dataBound = function(){
        scheduleObj.refreshTemplates(
            "resourceHeaderTemplate"
        );
        createAutoScheduleButton();
    };
}

function initializeGridEvents() {

    gridObj.rowDrop = function(args){

        args.cancel = true;

        var target =
            ej.base.closest(
                args.target,
                '.e-work-cells'
            );

        if (!target) {
            return;
        }

        var cell =
            scheduleObj.getCellDetails(target);

        var resource =
            scheduleObj.getResourcesByIndex(
                cell.groupIndex
            );

        var data = args.data[0];

        var duration =
            parseDuration(data.Duration);

        if (
            resource.resourceData.skills.indexOf(
                data.RequiredSkill
            ) === -1
        ) {
            return;
        }

        var startTime =
            new Date(cell.startTime);

        var endTime =
            new Date(
                startTime.getTime() +
                duration * 3600000
            );

        var workload = getResourceWorkloadForDate(resource.resourceData.id, startTime);
        if (workload + duration > MAX_DAILY_WORKLOAD) {
            return;
        }

        if (
            !isTimeSlotAvailableForResource(
                resource.resourceData.id,
                startTime,
                endTime
            )
        ) {
            return;
        }

        var newEvent = {
            Id: scheduleObj.getEventMaxID(),
            Subject: data.Task,
            StartTime: startTime,
            EndTime: endTime,
            StaffId: resource.resourceData.id,
            RequiredSkill: data.RequiredSkill,
            IsAllDay: false
        };

        safeDeleteGridRecord(data);

        scheduleObj.addEvent(newEvent);

        scheduleObj.refreshTemplates(
            "resourceHeaderTemplate"
        );
    };
}

</script>



<style>

