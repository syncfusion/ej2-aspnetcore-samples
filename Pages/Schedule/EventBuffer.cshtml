@page
@model EJ2CoreSampleBrowser.Pages.Schedule.EventBufferModel
@using Syncfusion.EJ2.Schedule

@using Syncfusion.EJ2.Popups

@{
    List<DialogDialogButton> dialogButtons = new List<DialogDialogButton>()
    {
        new DialogDialogButton()
        {
            Click = "closeDialog",
            ButtonModel = new
            {
                content = "OK",
                isPrimary = true
            }
        }
    };
}

@section ControlsSection {

<div class="control-section">

    <ejs-schedule id="Schedule"
                  height="650px"
                  cssClass="medical-scheduler"
                  width="100%"
                  startHour="08:00"
                  selectedDate="new DateTime(2026,1,12)"
                  currentView="TimelineDay"
                  allowOverlap="false"
                  resourceHeaderTemplate="#resourceTemplate"
                  headerIndentTemplate="#headerIndentTemplate"
                  actionBegin="onActionBegin"
                  dragStop="onDragStop">
        <e-schedule-timescale
            interval="60"
            slotCount="4">
        </e-schedule-timescale>
        <e-schedule-workhours start="08:00" end="18:00"></e-schedule-workhours>
        <e-schedule-views>
            <e-schedule-view option="Day"></e-schedule-view>
            <e-schedule-view option="TimelineDay"></e-schedule-view>
            <e-schedule-view option="TimelineWeek"></e-schedule-view>
        </e-schedule-views>

        <e-schedule-group resources="@(new string[] { "Rooms" })">
        </e-schedule-group>

        <e-schedule-resources>

            <e-schedule-resource field="RoomId"
                                 title="Operating Room"
                                 name="Rooms"
                                 dataSource="@Model.RoomData"
                                 textField="RoomText"
                                 idField="RoomId"
                                 colorField="RoomColor">
            </e-schedule-resource>

        </e-schedule-resources>

        <e-schedule-eventsettings dataSource="@Model.Events"
                                  enableBuffer="true"
                                  bufferTemplate="#bufferTemplate">
            <e-eventsettings-fields>
                <e-field-bufferbefore name="BufferBefore"></e-field-bufferbefore>
                <e-field-bufferafter name="BufferAfter"></e-field-bufferafter>
            </e-eventsettings-fields>
        </e-schedule-eventsettings>

    </ejs-schedule>

    <ejs-dialog id="specialityDialog"
                visible="false"
                isModal="true"
                width="320px"
                header="Alert"
                buttons="dialogButtons"
                content="Events cannot be scheduled in this operating room because it does not match the required specialty.">
    </ejs-dialog>

</div>

<script id="resourceTemplate" type="text/x-template">
    <div class="medical-resource">

        <div class="medical-resource-icon">
            ${resourceData.Icon}
        </div>

        <div class="medical-resource-content">

            <div class="medical-resource-specialty">
                ${resourceData.Specialty}
            </div>

        </div>

    </div>
</script>

<script id="bufferTemplate" type="text/x-template">
    ${renderBuffer(data, bufferType)}
</script>

<script id="headerIndentTemplate" type="text/x-template">
    ${getHeaderIndent()}
</script>

<script>

var roomData =
@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.RoomData));

var dialogButtons = [
    {
        buttonModel: {
            content: 'OK',
            isPrimary: true
        },
        click: function () {
            document
                .getElementById('specialityDialog')
                .ej2_instances[0]
                .hide();
        }
    }
];

function onDragStop(args) {

    var data =
        Array.isArray(args.data) ? args.data[0] : args.data;

    var room =
        roomData.find(r => r.RoomId === data.RoomId);

    if (!room) {
        return;
    }

    if (room.Specialty !== data.RequiredSkill) {

        args.cancel = true;

        var dialog =
            document.getElementById('specialityDialog').ej2_instances[0];

        var scheduleObj =
            document.getElementById('Schedule').ej2_instances[0];

        dialog.enableRtl =
            scheduleObj.element.classList.contains('e-rtl');

        dialog.show();
    }
}

function closeDialog() {
    document
        .getElementById('specialityDialog')
        .ej2_instances[0]
        .hide();
}


function getHeaderIndent() {

    var scheduleObj =
        document.getElementById('Schedule').ej2_instances[0];

    if (!scheduleObj) {
        return '';
    }

    if (scheduleObj.currentView === 'Day') {
        return '';
    }

    return `
        <div class="resource-header-title">
            <div class="resource-header-main">
                Operating Rooms
            </div>
            <div class="resource-header-sub">
                Surgery Suites
            </div>
        </div>
    `;
}

function onActionBegin(args) {

    if (args.requestType === 'eventCreate') {

        var records = Array.isArray(args.data)
            ? args.data
            : [args.data];

        records.forEach(function (event) {

            var room = roomData.find(
                r => r.RoomId === event.RoomId
            );

            if (room) {
                event.RequiredSkill = room.Specialty;
            }
        });
    }
}

window.renderBuffer = function (data, bufferType) {

    var scheduleObj =
        document.getElementById('Schedule').ej2_instances[0];

    var isDayView =
        scheduleObj &&
        scheduleObj.currentView === 'Day';

    var iconSrc =
        bufferType === 'before'
            ? '@Url.Content("~/css/schedule/images/health-day.svg")'
            : '@Url.Content("~/css/schedule/images/cancer-day.svg")';

    var bufferValue =
        bufferType === 'before'
            ? data.data.BufferBefore
            : data.data.BufferAfter;


    if (bufferValue < 10) {
        return '';
    }

    if (isDayView) {
        if (bufferValue <= 15) {
            return '<span class="buffer-duration">' +
                bufferValue +
                ' min</span>';
        }

        return '<div class="buffer-minimal">' +
            '<img class="buffer-svg-icon" src="' +
            iconSrc +
            '" />' +
            '<span class="buffer-duration">' +
            bufferValue +
            ' min</span>' +
            '</div>';
    }

    if (bufferValue <= 20) {
        return '<div class="buffer-minimal">' +
            '<img class="buffer-svg-icon" src="' +
            iconSrc +
            '" />';
    }

    return '<div class="buffer-minimal">' +
        '<img class="buffer-svg-icon" src="' +
        iconSrc +
        '" />' +
        '<span class="buffer-duration">' +
        bufferValue +
        ' min</span>' +
        '</div>';
};
</script>

<style>

.medical-resource {
    display: flex;
    align-items: center;
    height: 50px;
    gap: 16px;
    box-sizing: border-box;
}

.medical-scheduler.e-schedule .e-resource-cells {
    height: 70px !important;
}

.medical-scheduler.e-schedule .e-buffer-app {
    display: flex;
    align-items: center;
    justify-content: center;
}

.medical-scheduler.e-schedule img {
    height: 35px;
    width: 35px;
}

/* Buffer pill (before/after) */
.buffer-minimal {
    width: 100%;
    height: 100%;
    justify-content: flex-start;
    align-items: center;
    gap: 6px;
    overflow: hidden;
}

.e-day-wrapper .buffer-minimal {
  width: 100%;
  height: fit-content;
  display: grid;
  justify-content: center;
  align-items: center;
  gap: 6px;
  overflow: hidden;
}

.buffer-svg-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}

.buffer-duration {
    font-size: 10px;
    font-weight: 600;
    white-space: nowrap;
}

/* Small buffers: keep only the icon visible, but allow ellipsis on the duration */
.buffer-minimal .buffer-duration {
    overflow: hidden;
    text-overflow: ellipsis;
}

.buffer-info {
    min-width: 0;
    overflow: hidden;
}

/* Resource header (left panel) */
.medical-resource-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    flex-shrink: 0;
}

.medical-resource-content {
    min-width: 0;
}

.medical-resource-name {
    font-size: 13px;
    font-weight: 600;
    line-height: 18px;
}

.medical-resource-specialty {
    font-size: 11px;
    line-height: 16px;
}

/* Empty header (top-left) */
.resource-header-title {
    padding: 12px 16px;
}

.resource-header-main {
    font-size: 15px;
    font-weight: 600;
}

.resource-header-sub {
    margin-top: 2px;
    font-size: 11px;
}

.buffer-svg-icon {
    width: 14px;
    height: 14px;
}

</style>

}

@section ActionDescription {

<div id="action-description">
     <p>
        This surgery scheduling demo highlights efficient operating room management using configurable pre-procedure and post-procedure buffer times within the Scheduler. Plan surgeries with dedicated preparation and recovery periods, reduce scheduling overlaps, maximize operating room utilization, and streamline healthcare appointment coordination.
    </p>
</div>

}

@section Description {

<div id="description">
    <p>
        The <a target="_blank" href="https://help.syncfusion.com/cr/aspnetcore-js2/Syncfusion.EJ2.Schedule.ScheduleEventSettings.html">
            <code>enableBuffer</code>
        </a> property of <code>eventSettings</code> activates the buffer feature. The
        <code>bufferBefore</code> and <code>bufferAfter</code> field mappings (in minutes) are configured
        through <code>eventSettings.fields</code>, and a custom <code>bufferTemplate</code> renders an icon
        and the buffer duration inside the buffer pill. Conflict detection with <code>allowOverlap=false</code>
        also flags the buffered reserved range, and drag-and-drop is restricted to the room matching the
        event&rsquo;s required specialty.
    </p>
    <p>
        Buffers are supported across timeline and vertical time-grid views (Day, Week, WorkWeek, Timeline Day,
        Timeline Week, Timeline WorkWeek) and re-anchor on the EVENT edges during drag and resize previews.
    </p>
    <p>
        Looking for the full ASP.NETCore Scheduler component overview, features, pricing, and documentation? Visit our <a target="_blank" href="https://www.syncfusion.com/scheduler-sdk/aspnet-core-scheduler">ASP.NETCore Scheduler</a> component page.
    </p>
</div>

}

@section Title{
                    <title>ASP.NET Core Event Buffer Example - Syncfusion Demos </title> 
              }
@section Header{
                    <h1 class='sb-sample-text'>Example of Event Buffer in ASP.NET Core Scheduler Control</h1>
                }