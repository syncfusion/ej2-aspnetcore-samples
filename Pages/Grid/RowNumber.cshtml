@page
@model EJ2CoreSampleBrowser.Pages.Grid.RowNumberModel

@{
    ViewData["Title"] = "RowNumber";
}

@section ControlsSection {
    <div class="control-section">
        <ejs-grid id="Grid" dataSource="@Model.datasource" allowSorting="true" allowFiltering="true" allowExcelExport="true" allowPdfExport="true" enableVirtualization="true" filterSettings="@(new Syncfusion.EJ2.Grids.GridFilterSettings { Type = Syncfusion.EJ2.Grids.FilterType.CheckBox })" toolbarClick="toolbarClick" toolbar="@(new List<string>() { "Delete", "Update", "Cancel", "ExcelExport", "PdfExport" })" editSettings="@(new Syncfusion.EJ2.Grids.GridEditSettings { AllowEditing = true, AllowAdding = true, AllowDeleting = true, Mode = Syncfusion.EJ2.Grids.EditMode.Cell })" height="365" rowHeight="45" load="load" actionBegin="actionBegin">
            <e-grid-pagesettings pageSize="50"></e-grid-pagesettings>
            <e-grid-columns>
                <e-grid-column type="RowNumber" textAlign="Center"></e-grid-column>
                <e-grid-column field="ProductID" headerText="Product ID" width="120" visible="false" textAlign="Right" isPrimaryKey="true" type="number"></e-grid-column>
                <e-grid-column field="ProductName" headerText="Products" width="160" validationRules="@(new { required = true })" allowEditing="false"></e-grid-column>
                <e-grid-column field="Category" headerText="Category" width="140" validationRules="@(new { required = true })" allowEditing="false"></e-grid-column>
                <e-grid-column field="SellingPrice" headerText="Price" width="130" format="C" textAlign="Right" editType="numericedit" validationRules="@(new { required = true, min = 0 })" filter="@(new { type = "Menu" })" edit="@(new { @params = new { showSpinButton = false } })"></e-grid-column>
                <e-grid-column field="AvailableStock" headerText="In-Stock" width="120" textAlign="Right" template="#availableStockTemplate" editType="numericedit" validationRules="@(new { required = true, min = 0 })" filter="@(new { type = "Menu" })" edit="@(new { @params = new { showSpinButton = false } })"></e-grid-column>
                <e-grid-column field="SoldStock" headerText="Sold" width="120" textAlign="Right" template="#soldStockTemplate" editType="numericedit" validationRules="@(new { required = true, min = 0 })" filter="@(new { type = "Menu" })" edit="@(new { @params = new { showSpinButton = false } })"></e-grid-column>
            </e-grid-columns>
        </ejs-grid>
    </div>

    <script type="text/x-template" id="availableStockTemplate">
        <span>${AvailableStock} ${Unit}</span>
    </script>
    <script type="text/x-template" id="soldStockTemplate">
        <span>${SoldStock} ${Unit}</span>
    </script>

    <script>
        function load(args) {
            if (args) {
                args.enableSeamlessScrolling = true;
            }
        }

        function toolbarClick(args) {
            var gridObj = document.getElementById("Grid").ej2_instances[0];
            if (args.item.id === 'Grid_excelexport') {
                gridObj.excelExport();
            }
            if (args.item.id === 'Grid_pdfexport') {
                gridObj.pdfExport();
            }
        }

        function actionBegin(args) {
            if (args.requestType === 'save' && args.action === 'add') {
                if (args.data.Category === 'Beverages' || args.data.Category === 'Dairy Products') {
                    args.data.Unit = 'Litre';
                }
                else if (
                    args.data.Category === 'Fruits' || args.data.Category === 'Vegetables' ||
                    args.data.Category === 'Nuts' || args.data.Category === 'Rices'
                ) {
                    args.data.Unit = 'Kg';
                }
                else {
                    args.data.Unit = 'Pack';
                }
            }
        }
    </script>
}

@section ActionDescription {
    <div id="action-description">
        <p>This sample demonstrates the Row Number feature in the Data Grid, which automatically displays sequential row numbers in a dedicated column. It provides a simple way to identify the position of records in the current grid view.</p>
    </div>
}

@section Meta {
    <meta name="description" content="This example demonstrates the Row Number feature in ASP.NET Core Data Grid control. Explore here for more details." />
}

@section Description {
    <div id="description">
        <p>
            In this demo, the row number column is enabled by setting the <code>columns-&gt;type</code> property to <code>RowNumber</code>. The grid automatically generates and maintains row numbers for all displayed records, updating them appropriately during operations such as paging, sorting, filtering and grouping.
        </p>
        <p>
            More information on row configuration can be found in the <a target="_blank" href="https://ej2.syncfusion.com/aspnetcore/documentation/grid/row">documentation section</a>.
        </p>
        <p>
            Looking for the full ASP.NET Core Data Grid component overview, features, pricing, and documentation? Visit our <a target="_blank" href="https://www.syncfusion.com/aspnet-core-ui-controls/grid">ASP.NET Core Data Grid component</a> page.
        </p>
    </div>
}

@section Title {
    <title>ASP.NET Core Data Grid Row Number Feature Example - Syncfusion Demos </title>
}

@section Header {
    <h1 class='sb-sample-text'>Example of Row Number Feature in ASP.NET Core Data Grid Control</h1>
}
