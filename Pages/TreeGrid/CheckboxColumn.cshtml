@page
@using EJ2CoreSampleBrowser.Models;
@using Syncfusion.EJ2

@{
    ViewData["Title"] = "CheckboxColumn";
    var hierarchyModes = new[] {
        new { text = "Self", value = "Self" },
        new { text = "Hierarchy", value = "Hierarchy" },
        new { text = "Filtered Hierarchy", value = "FilteredHierarchy" }
    };
}

@section ControlsSection{

    <div class="control-section">
        <div class="content-wrapper">
            <div class="checkboxprop">
                <div class="checkboxmode">
                    <span>Hierarchy Checkbox Mode</span>
                    <div class="checkboxmode">
                        <ejs-dropdownlist id="hierarchyModes" dataSource="@hierarchyModes" fields-text="text" fields-value="value" value="@("Self")" width="180px" change="onHierarchyModeChange"></ejs-dropdownlist>
                    </div>
                </div>
            </div>
            <ejs-treegrid id="TreeGrid" dataSource="@CheckboxColumnData.GetCheckboxColumnData()" hierarchyCheckboxMode="Self" childMapping="SubTasks" treeColumnIndex="1" allowFiltering="true" height="380" queryCellInfo="queryCellInfo" toolbar='@(new List<string>() { "Search", "Delete" })'>
                <e-treegrid-editsettings allowDeleting="true"></e-treegrid-editsettings>
                <e-treegrid-columns>
                    <e-treegrid-column field="TaskID" visible="false" isPrimaryKey="true"></e-treegrid-column>
                    <e-treegrid-column field="TaskName" headerText="Task Name" width="270" showCheckbox="true"></e-treegrid-column>
                    <e-treegrid-column field="Assignee" headerText="Employee" width="180" textAlign="Center"></e-treegrid-column>
                    <e-treegrid-column field="Designation" headerText="Designation" width="220"></e-treegrid-column>
                    <e-treegrid-column field="Priority" headerText="Priority" width="140"></e-treegrid-column>
                    <e-treegrid-column field="Status" headerText="Status" width="120" textAlign="Center"></e-treegrid-column>
                    <e-treegrid-column field="Progress" headerText="Progress" format="P" width="120" textAlign="Right"></e-treegrid-column>
                </e-treegrid-columns>
            </ejs-treegrid>
        </div>
    </div>

    <script>
        function queryCellInfo(args) {
            if (args.column.field === "Status") {
                var statusClass = args.data.Status.toLowerCase().replace(/\s+/g, "-");
                args.cell.innerHTML = '<span class="status-badge ' + statusClass + '">' + args.data.Status + '</span>';
            }
        }

        function onHierarchyModeChange(e) {
            var treegrid = document.getElementById("TreeGrid").ej2_instances[0];
            var hierarchyDropDown=document.getElementById("hierarchyModes").ej2_instances[0];
            var value = hierarchyDropDown.value;
            if (value === "Hierarchy") {
                treegrid.hierarchyCheckboxMode = "hierarchy";
            } else if (value === "Filtered Hierarchy") {
                treegrid.hierarchyCheckboxMode = "filteredHierarchy";
            } else if (value === "Self") {
                treegrid.hierarchyCheckboxMode = "self";
            }
        }
    </script>
}

@section Meta{
    <meta name="description" content="This example demonstrates the Checkbox Column in ASP.NET Core Tree Grid control. Explore here for more details." />
}

@section ActionDescription{
    <!-- custom code start -->
    <div id="action-description">
        <p>
            This sample demonstrates hierarchical checkbox selection in the TreeGrid
            using the <code>hierarchyCheckboxMode</code> property.
        </p>
    </div>
    <!-- custom code end -->
}

@section Description{
    <!-- custom code start -->
    <div id="description">
        <p>
            Checkboxes are displayed in the Tree Grid tree column by enabling the
            <code><a target="_blank" class="code"
                href="https://ej2.syncfusion.com/documentation/api/treegrid/#showcheckbox">showCheckbox</a></code>
            property. The checkbox selection behavior across hierarchical records is controlled through the
            <code><a target="_blank" class="code"
                href="https://ej2.syncfusion.com/documentation/api/treegrid/#hierarchycheckboxmode">hierarchyCheckboxMode</a></code>
            property.
        </p>

        <p>
            In <strong>self</strong> mode, selecting a checkbox affects only the clicked row.
            In <strong>hierarchy</strong> mode, selecting a parent row automatically selects all its child rows, and changes made to child rows are reflected in their parent rows.
            The <strong>filteredHierarchy</strong> mode behaves similarly to hierarchy mode but applies selection only to the rows currently visible after filtering or searching.
        </p>

        <p>
            On touch-enabled devices, checkboxes can be selected or cleared by tapping them directly.
        </p>

        <p>
            More information on checkbox column can be found in this
            <a target="_blank"
                href="https://ej2.syncfusion.com/aspnetcore/documentation/tree-grid/columns/columns-core#checkbox-column">
                documentation section</a>.
        </p>

        <p>
            Looking for the full ASP.NET Core Tree Grid component overview, features, pricing, and documentation?
            Visit our
            <a target="_blank"
                href="https://www.syncfusion.com/aspnet-core-ui-controls/tree-grid">
                ASP.NET Core Tree Grid component</a>
            page.
        </p>
    </div>
    <!-- custom code end -->
}

@section Title{
    <title>ASP.NET Core Tree Grid Checkbox Column Example - Syncfusion Demos </title>
}
@section Header{
    <h1 class='sb-sample-text'>Example of Checkbox Column in ASP.NET Core Tree Grid Control</h1>
}

<style>
    .e-bigger.bootstrap5 .e-treegrid .e-hierarchycheckbox .e-frame,
    .e-bigger.bootstrap5-dark .e-treegrid .e-hierarchycheckbox .e-frame,
    .e-bigger.bootstrap4 .e-treegrid .e-hierarchycheckbox .e-frame {
        height: 17px;
        width: 17px;
    }

    .checkboxprop {
        padding-bottom: 5px;
    }

    .checkboxmode {
        display: inline-block;
    }

    .checkboxprop > .checkboxmode {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .checkboxprop > .checkboxmode > span {
        white-space: nowrap;
    }

    .checkboxprop > .checkboxmode > .checkboxmode {
        flex: 0 0 180px;
        width: 180px;
    }

    .status-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .completed {
        background: #dcfce7;
        color: #15803d;
    }

    .in-progress {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .not-started {
        background: #f3f4f6;
        color: #4b5563;
    }

    .under-review {
        background: #fef3c7;
        color: #b45309;
    }

    .blocked {
        background: #fee2e2;
        color: #dc2626;
    }
</style>
