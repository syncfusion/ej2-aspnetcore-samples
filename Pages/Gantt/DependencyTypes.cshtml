@page
@using EJ2CoreSampleBrowser.Models
@using Syncfusion.EJ2.Gantt
@model EJ2CoreSampleBrowser.Pages.Gantt.DependencyTypesModel

@section ControlsSection {
    <div class="control-section">
        <div style="margin-bottom:12px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <label style="font-weight:600;margin:0;">
                    Allowed Dependency Types:
                </label>
                <ejs-multiselect id="dependencyTypes"
                                dataSource="@Model.DependencyTypes"
                                value="@Model.DefaultValues"
                                mode="CheckBox"
                                showDropDownIcon="true"
                                showClearButton="false"
                                popupHeight="220px"
                                width="250px"
                                change="dependencyTypeChange">

                    <e-multiselect-fields text="Text"
                                        value="Value">
                    </e-multiselect-fields>
                </ejs-multiselect>

            </div>
        </div>

        <ejs-gantt id="DependencyTypes"
                dataSource="@GanttData.DependencyData()"
                height="650px"
                rowHeight="46"
                taskbarHeight="25"
                allowSelection="true"
                highlightWeekends="true"
                treeColumnIndex="1"
                gridLines="Both"
                projectStartDate="01/01/2026"
                allowedDependencyTypes="@Model.DefaultValues"
                toolbar="@(new List<string>() { "Add", "Edit", "Update", "Delete", "Cancel", "ExpandAll", "CollapseAll" })">

            <e-gantt-taskfields id="TaskId"
                                name="TaskName"
                                startDate="StartDate"
                                endDate="EndDate"
                                duration="Duration"
                                progress="Progress"
                                dependency="Predecessor"
                                parentID="ParentID">
            </e-gantt-taskfields>

            <e-gantt-editsettings allowAdding="true"
                                allowEditing="true"
                                allowDeleting="true"
                                allowTaskbarEditing="true"
                                showDeleteConfirmDialog="true">
            </e-gantt-editsettings>

            <e-gantt-labelsettings leftLabel="TaskName">
            </e-gantt-labelsettings>

            <e-gantt-splittersettings columnIndex="3">
            </e-gantt-splittersettings>

            <e-gantt-columns>
                <e-gantt-column field="TaskId" visible="false"></e-gantt-column>
                <e-gantt-column field="TaskName" headerText="Task Name" width="200"></e-gantt-column>
                <e-gantt-column field="Predecessor" headerText="Dependency" width="140"></e-gantt-column>
                <e-gantt-column field="StartDate" headerText="Start Date" width="130"></e-gantt-column>
                <e-gantt-column field="Duration" headerText="Duration" width="110"></e-gantt-column>
                <e-gantt-column field="Progress" headerText="Progress" width="100"></e-gantt-column>
            </e-gantt-columns>

        </ejs-gantt>

    </div>

    <script>
        ej.dropdowns.MultiSelect.Inject( 
            ej.dropdowns.CheckBoxSelection
        );
        function dependencyTypeChange(args) {
            var ganttObj = document.getElementById('DependencyTypes').ej2_instances[0];
            ganttObj.allowedDependencyTypes = args.value;
            ganttObj.refresh();
        }

    </script>
}
@section ActionDescription {
    <div id="action-description">
        <p>
            The Gantt Chart supports dependency types to define
            relationships between tasks, helping control execution
            order and project sequencing.
        </p>
    </div>
}
@section Description {
    <div id="description">

        <p>
            The Gantt Chart supports various dependency relationship
            types to manage task links. The
            <code>allowedDependencyTypes</code> property is used
            to restrict the dependency types available during task
            editing and dependency creation.
        </p>
        <p>
            The different dependency types are:
        </p>
        <ul>
            <li><code>FS</code> - Finish to Start</li>
            <li><code>SS</code> - Start to Start</li>
            <li><code>FF</code> - Finish to Finish</li>
            <li><code>SF</code> - Start to Finish</li>
        </ul>
        <p>
            When dependency types are configured, the Gantt validates
            newly created and modified links against the selected
            relationship types.
        </p>
        <p>More information on the Essential<sup>®</sup> Gantt Chart can be found in this <a target="_blank" href="https://help.syncfusion.com/gantt-sdk/asp-net-core/gantt-chart/task-dependency">task dependency</a> documentation section.</p>
        <br/>
        <p>Looking for the full ASP.NET Core Gantt Chart component overview, features, pricing, and documentation? Visit the <a target="_blank" href="https://www.syncfusion.com/gantt-sdk/aspnet-core-gantt-chart">ASP.NET Core Gantt Chart</a> page.</p>
    </div>
}
@section Meta {
    <meta name="description" content="This example demonstrates the Dependency Types feature in ASP.NET Core Gantt control." />
}

@section Title {
    <title>
        ASP.NET Core Gantt Dependency Types Example - Syncfusion Demos
    </title>
}

@section Header {
    <h1 class="sb-sample-text">
        Example of Dependency Types in ASP.NET Core Gantt Control
    </h1>
}