@page
@model EJ2CoreSampleBrowser.Pages.FormRenderer.DefaultModel
@using Syncfusion.EJ2

@section ControlsSection{
<div class="control-section">
    <div class="col-lg-9 control-section sb-property-border">
        <div id="form-control control-wrapper">
              <ejs-form-renderer id="form-renderer-control" schema="@Model.FormSchema"></ejs-form-renderer>
        </div>
    </div>
    <div id="form-renderer-panel" class="col-lg-3 property-section">
        <div class="property-panel-section">
            <table id="property" class="property-panel-table" title="Select a ready-to-use form template"
                style="width: 100%;table-layout: auto;">
                <tr>
                    <td colspan="2" style="padding-bottom: 2px;">
                        <div>
                             <ejs-radiobutton id="radio1" label="User Registration" name="formSchemaOption" value="userRegistration"
                                checked="true" change="changeSchema"></ejs-radiobutton>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" style="padding-bottom: 2px;">
                        <div>
                              <ejs-radiobutton id="radio2" label="Customer Service" name="formSchemaOption" value="customerService"
                                change="changeSchema"></ejs-radiobutton>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <div>
                             <ejs-radiobutton id="radio3" label="Doctor Appointment" name="formSchemaOption" value="doctorsAppointment"
                                change="changeSchema"></ejs-radiobutton>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
}
<script src="~/scripts/form-renderer/datasource.js"></script>

<script>
   window.changeSchema = function (args) {
    var formRenderer = document.getElementById('form-renderer-control').ej2_instances[0];
    if (!formRenderer) return;

    if (args.value === 'userRegistration') {
        formRenderer.schema = window.userRegistration;
    } else if (args.value === 'customerService') {
        formRenderer.schema = window.customerService;
    } else if (args.value === 'doctorsAppointment') {
        formRenderer.schema = window.doctorsAppointment;
    }
    formRenderer; // force re-render
};

</script>

<style>
    #form-renderer-panel .property-panel-table div {
        padding-left: 0px !important;
         padding-top: 0px !important;

    }
    .container-fluid{
         padding-right: 0px !important;
    }
    .control-section{
        padding-left: 0px !important;
         padding-top: 0px !important;
    }
}

</style>


@section Meta{
<meta name="description" content="This example demonstrates the Syncfusion ASP.NET Core Form Renderer component that renders schema driven form. Explore here for more details." />
}
@section ActionDescription{
<div id="action-description">
    <p>
        The <code>FormRenderer</code> is a powerful, schema-driven component that enables you to build and render
        complex
        forms with ease using a structured JSON schema definition.
        <br />
        This sample showcases the Form Renderer component with an intuitive property panel, allowing you to
        seamlessly switch between predefined form schemas and explore its capabilities.
    </p>
</div>
}
@section Description{
<div id="description">
    <p>
        In this sample, multiple ready-to-use form templates—such as <b>User Registration</b>, <b>Customer
            Service</b>, and <b>Doctor Appointment</b>—are displayed in the property panel using radio buttons.
        Select any option to instantly apply the corresponding form definition to the Form Renderer component via
        the <code>schema</code> property.
    </p>
    <p>
        Each form can be filled out interactively and submitted for data collection, demonstrating how the component
        streamlines form creation, customization, and data capture in real-world scenarios.
    </p>
</div>
}
@section Title{
<title>ASP.NET Core Form Renderer DefaultFunctionalities Example - Syncfusion Demos </title>
}
@section Header{
<h1 class='sb-sample-text'>Example of Default Functionalities in ASP.NET Core Form Renderer Control</h1>
}
@section CustomCanonicalURL{
    <link rel="canonical" href="https://www.syncfusion.com/aspnet-core-ui-controls/form-renderer" />
}