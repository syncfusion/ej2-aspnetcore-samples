@page
@model EJ2CoreSampleBrowser.Pages.Grid.ProductCatalogModel


@{
    ViewData["Title"] = "ProductCatalog";
}

@section ControlsSection {

<div class="control-section">

    <ejs-grid id="Grid"
              dataSource="@Model.Products"
              allowSorting="true"
              allowFiltering="true"
              detailTemplate="#detailTemplate"
              detailDataBound="detailDataBound"
              height="500">

        <e-grid-filterSettings type="Excel"></e-grid-filterSettings>

        <e-grid-columns>

            <e-grid-column field="ProductID"
                           headerText="ID"
                           width="80"
                           textAlign="Left"
                           isPrimaryKey="true"
                           height="520">
            </e-grid-column>

            <e-grid-column field="ProductName"
                           headerText="Product"
                           width="250"
                           textAlign="Center"
                           template="#productTemplate">
            </e-grid-column>

            <e-grid-column field="Category"
                           headerText="Category"
                           textAlign="Center"
                           width="120">
            </e-grid-column>

            <e-grid-column headerText="Sales"
                           width="120"
                           textAlign="Center"
                           template="#salesTemplate">
            </e-grid-column>

            <e-grid-column field="Price"
                           headerText="Price"
                           width="120"
                           format="C2"
                           textAlign="Center">
            </e-grid-column>
            <e-grid-column field="Status"
                           headerText="Status"
                           width="140"
                           textAlign="Center"
                           template="#statusTemplate">
            </e-grid-column>

        </e-grid-columns>

    </ejs-grid>

</div>
}

<script id="productTemplate" type="text/x-jsrender">
    ${getProductTemplate(data)}
</script>

<script>
function getProductTemplate(data) {

 var imagePath = "../scripts/Images/Grid/" + data.ProductName + ".png";

    return `
        <div class="product-cell">
            <img src="${imagePath}" class="product-image" alt="${data.ProductName}" />
            <div class="product-copy">
                <div class="product-name">${data.ProductName}</div>
                <div class="product-meta">
                    <span class="product-description">${data.Description}</span>
                    <span class="product-sku">SKU: ${data.SKU}</span>
                </div>
            </div>
        </div>
    `;
}

</script>
<script id="salesTemplate" type="text/x-jsrender">
${getSalesTemplate(data)}
</script>



<script id="statusTemplate" type="text/x-jsrender">
${getStatusTemplate(data)}
</script>

<script id="detailTemplate" type="text/x-template">
    <div class="detail-page">
        <div class="detail-top">
            <div class="product-detail-wrapper">
                <div class="detail-grid">
                    <div class="e-card">
                        <div class="e-card-header">
                            <div class="e-card-header-caption">
                                <div class="e-card-title">Product Description</div>
                            </div>
                        </div>
                        <div class="e-card-content">
                            <div class="product-description-text">${ProductDescription}</div>
                            <h4 class="sub-title">Key Highlights</h4>
                            <ul class="highlight-list"></ul>
                        </div>
                    </div>

                    <div class="e-card">
                        <div class="e-card-header">
                            <div class="e-card-header-caption">
                                <div class="e-card-title">Technical Specifications</div>
                            </div>
                        </div>
                        <div class="e-card-content specification-content"></div>
                    </div>

                    <div class="e-card">
                        <div class="e-card-header">
                            <div class="e-card-header-caption">
                                <div class="e-card-title">Pricing Details</div>
                            </div>
                        </div>
                        <div class="e-card-content">
                            <div class="info-row">
                                <span>Current Price</span>
                                <span class="current-price">${formatCurrency(Price)}</span>
                            </div>
                            <div class="info-row">
                                <span>Original Price</span>
                                <span class="original-price">${formatCurrency(OriginalPrice)}</span>
                            </div>
                            <div class="info-row">
                                <span>Discount</span>
                                <span class="discount-price">${getDiscount(OriginalPrice, Price)}%</span>
                            </div>
                            <div class="info-row">
                                <span>Cost Price</span>
                                <span class="cost-price">${formatCurrency(CostPrice)}</span>
                            </div>
                            <div class="info-row">
                                <span>Profit Margin</span>
                                <span class="profit-price">${ProfitMargin}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</script>

<script>
function detailDataBound(args) {
    var highlightList = args.detailElement.querySelector('.highlight-list');
    var specContainer = args.detailElement.querySelector('.specification-content');

    if (highlightList) {
        var highlights = args.data.Highlights;

        if (typeof highlights === 'string') {
            highlights = highlights.split(',');
        }

        if (highlights && highlights.length) {
            highlightList.innerHTML = '';
            highlights.forEach(function (item) {
                var li = document.createElement('li');
                li.innerHTML = '<span class="bullet"></span><span>' + item + '</span>';
                highlightList.appendChild(li);
            });
        } else {
            highlightList.innerHTML = '';
        }
    }

    if (specContainer && args.data.Specifications) {
        var html = '';

        Object.keys(args.data.Specifications).forEach(function (key) {
            html += '<div class="info-row">' +
                '<span>' + key + '</span>' +
                '<strong>' + args.data.Specifications[key] + '</strong>' +
                '</div>';
        });

        specContainer.innerHTML = html;
    }
}

function getSalesTemplate(data) {

    var trend =
        ((data.SalesMonth3 - data.SalesMonth2) /
        Math.max(data.SalesMonth2, 1)) * 100;

    var icon = trend >= 0 ? "↑" : "↓";

    return `
        <div class="sales-cell">
            <span class="sales-number">${data.SalesMonth3.toLocaleString()}</span>
            <span class="sales-growth ${trend >= 0 ? 'positive' : 'negative'}">${icon} ${Math.abs(trend).toFixed(1)}%</span>
        </div>`;
}

function getStatusTemplate(data) {

    var cls = data.Status === "In Stock"
        ? "status-success"
        : "status-danger";

    return `
        <div class="status-cell">

            <span class="status-badge ${cls}">
                ${data.Status}
            </span>

            <div class="status-units">
                ${data.Units} units
            </div>

        </div>
    `;
}

function getDiscount(original, price) {
    if (!original || !price) {
        return "0";
    }

    var discount = ((original - price) / original) * 100;
    return Math.round(discount);
}

function formatCurrency(value) {
    var number = Number(value);

    if (isNaN(number)) {
        number = 0;
    }

    return '$' + number.toLocaleString();
}

</script>

