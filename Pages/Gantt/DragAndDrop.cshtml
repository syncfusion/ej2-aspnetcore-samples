@page
@using EJ2CoreSampleBrowser.Models;
@using Syncfusion.EJ2.Gantt;

@section ControlsSection{
    <div class="control-section">
        <div class="row">
            <div class="col-md-12">
                <ejs-gantt id='DragAndDrop' dataSource="@GanttData.ProjectNewData()" height="650px" rowHeight="46" taskbarHeight="25"
                    allowRowDragAndDrop="true" highlightWeekends="true" treeColumnIndex="1" projectStartDate="03/26/2025"
                    projectEndDate="07/20/2025" allowTaskbarDragAndDrop="true">
                    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration"
                        progress="Progress" dependency="Predecessor" parentID="ParentID" >
                    </e-gantt-taskfields>
                    <e-gantt-editsettings allowAdding="true" allowEditing="true" allowDeleting="true" allowTaskbarEditing="true"
                        showDeleteConfirmDialog="true"></e-gantt-editsettings>
                    <e-gantt-columns>
                        <e-gantt-column field="TaskId" headerText="ID" width="80"></e-gantt-column>
                        <e-gantt-column field="TaskName" headerText="Name" width="250"></e-gantt-column>
                        <e-gantt-column field="StartDate"></e-gantt-column>
                        <e-gantt-column field="Duration"></e-gantt-column>
                        <e-gantt-column field="Progress"></e-gantt-column>
                        <e-gantt-column field="Predecessor" headerText="Dependency"></e-gantt-column>
                    </e-gantt-columns>
                    <e-gantt-splittersettings columnIndex="3"></e-gantt-splittersettings>
                    <e-gantt-selectionsettings type="Multiple"></e-gantt-selectionsettings>
                    <e-gantt-labelSettings leftLabel="TaskName"></e-gantt-labelSettings>
                </ejs-gantt>
            </div>
        </div>
    </div>
}

@section ActionDescription{
    <div id="action-description">
        <p>This sample demonstrates the row drag-and-drop feature in the Gantt Chart. Tasks can be reordered by dragging the drag handle displayed in the left side of the Gantt row. Rows can be dropped at the required position to reorganize the task hierarchy and sequence.</p>
    </div>
}

@section Description{
    <div id="description">
        <p>
            Row drag and drop feature can be enabled by settting <a target="_blank" href="https://help.syncfusion.com/cr/aspnetcore-js2/Syncfusion.EJ2.Gantt.Gantt.html#Syncfusion_EJ2_Gantt_Gantt_AllowRowDragAndDrop" aria-label="Navigate to the allowRowDragAndDrop property reference for ASP.NET Core Gantt Chart control">
                allowRowDragAndDrop
            </a> property as true. In this demo, taskbar drag and drop between rows can be enabled by setting <a target="_blank" href="https://help.syncfusion.com/cr/aspnetcore-js2/Syncfusion.EJ2.Gantt.Gantt.html#Syncfusion_EJ2_Gantt_Gantt_AllowTaskbarDragAndDrop" aria-label="Navigate to the allowTaskbarDragAndDrop property reference for ASP.NET Core Gantt Chart control">
                allowTaskbarDragAndDrop
            </a> as true.
        </p>
        <p>More information on the Essential<sup>®</sup> Gantt Chart can be found in this <a target="_blank" href="https://ej2.syncfusion.com/aspnetcore/documentation/gantt/drag-and-drop">drag and drop</a> documentation section.</p>
        <br/>
        <p>Looking for the full ASP.NET Core Gantt Chart component overview, features, pricing, and documentation? Visit the <a target="_blank" href="https://www.syncfusion.com/gantt-sdk/aspnet-core-gantt-chart">ASP.NET Core Gantt Chart</a> page.</p>
    </div>
}

@section Meta{
    <meta name="description" content="This example demonstrates the Row Drag and Drop in ASP.NET Core Gantt control. Explore here for more details." />
}
@section Title{
    <title>ASP.NET Core Gantt Row Drag and Drop Example - Syncfusion Demos </title>
}
@section Header{
    <h1 class='sb-sample-text'>Example of Row Drag and Drop in ASP.NET Core Gantt Control</h1>
}